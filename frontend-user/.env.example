# =============================================================================
# Civic Issue Reporting Platform - Citizen Web Portal Environment Configuration
# =============================================================================

# Backend Express API Orchestrator Base URL (default port: 5000)
VITE_API_URL=http://localhost:5000

# =============================================================================
# Firebase Client Web SDK Configuration
# (Found in Firebase Console -> Project Settings -> General -> Your apps -> Web app)
# =============================================================================
VITE_FIREBASE_API_KEY=your_firebase_api_key_here
VITE_FIREBASE_AUTH_DOMAIN=your_project.firebaseapp.com
VITE_FIREBASE_PROJECT_ID=your_project_id
VITE_FIREBASE_STORAGE_BUCKET=your_project.firebasestorage.app
VITE_FIREBASE_MESSAGING_SENDER_ID=your_messaging_sender_id
VITE_FIREBASE_APP_ID=your_app_id
VITE_FIREBASE_MEASUREMENT_ID=your_measurement_id

# =============================================================================
# Firebase Cloud Messaging (FCM) Web Push VAPID Key Pair
# (Found in Firebase Console -> Project Settings -> Cloud Messaging -> Web Push certificates)
# =============================================================================
VITE_FIREBASE_VAPID_KEY=your_fcm_web_push_vapid_key_pair_here
