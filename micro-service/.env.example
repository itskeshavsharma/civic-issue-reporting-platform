# =============================================================================
# Civic AI Microservice (FastAPI + Florence-2 + FLAN-T5 + MiniLM) Configuration
# =============================================================================

# Server Bind Host & Port (default: 0.0.0.0:8000)
HOST=0.0.0.0
PORT=8000

# =============================================================================
# Hardware Acceleration & Compute Device Override
# Auto-detects NVIDIA CUDA GPU by default. Falls back to CPU if no GPU is found.
# Options: cuda | cpu (leave commented or empty for auto-detection)
# =============================================================================
# FORCE_DEVICE=cuda
# FORCE_DEVICE=cpu

# =============================================================================
# Allowed CORS Origins
# Comma-separated list of origins or '*' for unrestricted internal access from backend
# =============================================================================
CORS_ORIGINS=*
