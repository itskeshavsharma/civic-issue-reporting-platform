# =============================================================================
# Civic Municipal Issue Reporting Platform - Backend Environment Configuration
# =============================================================================

# Server Port (default: 5000)
PORT=5000

# Node Environment: development | production
NODE_ENV=development

# MongoDB Connection String (Spatial 2dsphere indexing & data storage)
# Local: mongodb://127.0.0.1:27017/civic_db
# Cloud: mongodb+srv://<username>:<password>@cluster.mongodb.net/civic_db?retryWrites=true&w=majority
MONGO_URI=mongodb://127.0.0.1:27017/civic_db

# =============================================================================
# AI MICROSERVICE SINGLE POINT URL
# Point this to the FastAPI AI microservice instance (local or deployed)
# =============================================================================
AI_MICROSERVICE_URL=http://127.0.0.1:8000

# =============================================================================
# Firebase Admin SDK Configuration
# Relative or absolute path to your Firebase service account private key JSON file
# IMPORTANT: Never commit serviceAccountKey.json to git!
# =============================================================================
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# =============================================================================
# Cloudinary Storage Configuration (Upload pipeline for complaints & proofs)
# =============================================================================
CLOUDINARY_CLOUD_NAME=your_cloud_name
CLOUDINARY_API_KEY=your_api_key
CLOUDINARY_API_SECRET=your_api_secret
CLOUDINARY_URL=cloudinary://your_api_key:your_api_secret@your_cloud_name

# =============================================================================
# ALLOWED CLIENT ORIGIN(S) FOR CORS
# Comma-separated list of allowed frontend domains.
# 5173: Citizen Web Portal | 5174: Municipal Admin & Staff Portal
# =============================================================================
CLIENT_ORIGIN=http://localhost:5173,http://localhost:5174

# =============================================================================
# Spatial Deduplication Radius (in meters) for similar civic issues (default: 200)
# =============================================================================
DEDUPLICATION_RADIUS_METERS=200
